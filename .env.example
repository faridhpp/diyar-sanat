# Generate distinct hex passwords with: openssl rand -hex 32
# Hex avoids URL-encoding issues in Docker Compose connection strings.
POSTGRES_PASSWORD=
DATABASE_APP_PASSWORD=
APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Development/CLI connection URLs; production Compose supplies them per service.
DATABASE_URL=postgresql://diyar_app:APP_PASSWORD@localhost:5432/diyar
DATABASE_ADMIN_URL=postgresql://postgres:ADMIN_PASSWORD@localhost:5432/diyar
DATABASE_POOL_SIZE=10
UPLOAD_DIR=./data/uploads
# Only needed temporarily to create the first manager.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PHONE=
# Optional SMS provider secrets; configure the provider/template in /admin/settings.
KAVENEGAR_API_KEY=
SMS_IR_API_KEY=
IPPANEL_API_KEY=
IPPANEL_SENDER=
