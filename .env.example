# Paste the connection URL of your EXISTING Dokploy PostgreSQL service.
# Use its internal hostname, database name, username and URL-encoded password.
DATABASE_URL=postgresql://USERNAME:PASSWORD@DOKPLOY_POSTGRES_HOST:5432/DATABASE

# Optional: pin the public origin. By default, authentication uses the request Host.
# APP_URL=https://your-domain.com
DATABASE_POOL_SIZE=10
UPLOAD_DIR=./data/uploads

# Optional, used once by the manager bootstrap command.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PHONE=

# Optional SMS provider secrets.
KAVENEGAR_API_KEY=
SMS_IR_API_KEY=
IPPANEL_API_KEY=
IPPANEL_SENDER=
